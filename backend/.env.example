# Backend environment variables — Meldra AI Ltd.
# Copyright (c) 2025 Meldra AI Ltd. All rights reserved.
# Copy this to .env and fill in your values

# ── AI ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── AWS / S3 Data Lake ───────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=eu-west-2
S3_WAREHOUSE_URI=s3://your-bucket/iceberg-warehouse

# ── Apache AGE (PostgreSQL Graph DB) ─────────────────
GRAPH_DB_HOST=your-age-host.railway.internal
GRAPH_DB_PORT=5432
GRAPH_DB_USER=postgres
GRAPH_DB_PASSWORD=your-password
GRAPH_DB_NAME=graphdb

# ── JWT Authentication ────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MFA — Email via Resend.com ────────────────────────
# Get free API key at https://resend.com (100 emails/day free)
RESEND_API_KEY=re_...
MFA_FROM_EMAIL=noreply@meldra-lakeshouse.ai
MFA_FROM_NAME=Meldra AI

# ── App Domain ────────────────────────────────────────
APP_DOMAIN=https://meldra-lakeshouse.ai

# ── CORS — set to your Vercel URL ─────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOW_ORIGINS=https://meldra-lakeshouse.ai,https://www.meldra-lakeshouse.ai,http://localhost:5173
